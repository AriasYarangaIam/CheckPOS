# Copy to .env for local development:  Copy-Item .env.example .env
#
# Nothing here is a secret. These are throwaway credentials for the local
# PostgreSQL container defined in docker-compose.yml (host port 5433, because
# 5432 is already taken on this machine).

DATABASE_URL=postgres://pos:pos_local_dev@localhost:5433/pos?sslmode=disable

# JWT signing key (docs/BACKEND.md §2.5, §5.1). REQUIRED: the process refuses to
# start without it, and there is deliberately no committed default, because a
# default signing key is a token anybody who reads this file can forge. Generate
# your own (at least 32 bytes) and keep it outside the repository in every
# environment above local development:
#
#   openssl rand -base64 48
#
# The value below is a placeholder for the local container, not a key.
JWT_SECRET=replace-this-placeholder-with-at-least-32-bytes-of-local-entropy

# Access token lifetime (docs/BACKEND.md §2.5). This is NOT the device offline
# window: that one lives in `devices.offline_session_valid_until` and lasts at
# least 7 days (docs/BACKEND.md §5.2). Default when unset: 12h.
JWT_TTL=12h
